---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About Tafif | Web Developer">
  <!-- Hero Section -->
  <section
    class="bsb-hero-1 px-3 bsb-overlay bsb-hover-pull"
    style="background-image: url('/assets/img/hero/hero-home1.jpg');"
  >
    <div class="container">
      <div class="row justify-content-md-center">
        <div
          class="col-12 col-md-11 col-lg-9 col-xl-7 col-xxl-6 text-center text-white"
        >
          <h1 class="display-3 fw-bold mb-3 animate-fade-down">About Me</h1>
          <p class="lead mb-0 animate-fade-up">
            Get to know the person behind the code.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="bg-light py-5 py-md-8 py-xl-10">
    <div class="container overflow-hidden">
      <div
        class="row gy-2 gy-md-0 justify-content-xxl-center align-items-center"
      >
        <div class="col-12 order-md-0 col-md-4 col-xxl-4">
          <div class="text-center text-md-start me-md-3 me-xl-5">
            <img
              class="img-fluid rounded shadow-lg"
              loading="lazy"
              src="/assets/img/about/tafif.jpg"
              alt="Tafif Assiddiqi"
            />
          </div>
        </div>
        <div class="col-12 order-md-1 col-md-8 col-xxl-6">
          <div class="text-center text-md-start">
            <h2 class="display-3 fw-bold lh-1 mb-3">Tafif Assiddiqi</h2>
            <span class="badge bg-primary fs-6 mb-3">Web Developer</span>
            <span class="badge bg-info fs-6 mb-3">AI Enthusiast</span>

            <p class="lead mt-3 text-secondary">
              I am a motivated Computer Science undergraduate at Tanjungpura
              University, passionate about bridging the gap between complex data
              and user-friendly web interfaces.
            </p>
            <p>
              My journey currently involves deep diving into <strong
                >Web Development</strong
              > and <strong>Machine Learning</strong>. I've actively
              participated in various tech cohorts and competitions, sharpening
              my skills in building scalable backends and intelligent models.
            </p>
            <p>
              Notable achievements include being a <strong
                >Bangkit 2023 Cohort (Cloud Computing)</strong
              >, and a finalist in prestigious competitions like <strong
                >Compfest UI 15 (AI Challenge)</strong
              > and <strong>Gemastik XVI (Data Mining)</strong>.
            </p>

            <div class="d-grid gap-2 d-md-block mt-5">
              <a
                href="https://1drv.ms/w/s!Ah--BAT2NLljiokYKFgsKe1gpH0mQA?e=87QROn"
                target="_blank"
                class="btn btn-primary btn-lg px-4 gap-3">Download Resume</a
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services / Skills Breakdown -->
  <section class="py-5 py-md-8 py-xl-10">
    <div class="container">
      <div class="row justify-content-md-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-7 col-xxl-6">
          <h2 class="mb-4 display-5 text-center">Core Competencies</h2>
          <hr class="w-50 mx-auto mb-5 mb-xl-9 border-dark-subtle" />
        </div>
      </div>
    </div>

    <div class="container overflow-hidden">
      <div class="row gy-5">
        <div class="col-12 col-sm-6 col-lg-4">
          <div class="text-center px-xl-2 service-card">
            <div class="icon-circle mb-4 bg-primary-subtle text-primary">
              <!-- Icon code preserved from legacy but wrapped differently -->
              <span class="fs-1 fw-bold">1</span>
            </div>
            <h5 class="m-2">Web Development</h5>
            <p class="m-0 text-secondary">
              Strong Backend API & Service development (Express.js, Hapi.js).
            </p>
          </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
          <div class="text-center px-xl-2 service-card">
            <div class="icon-circle mb-4 bg-info-subtle text-info">
              <span class="fs-1 fw-bold">2</span>
            </div>
            <h5 class="m-2">Machine Learning</h5>
            <p class="m-0 text-secondary">
              Building models with Python & TensorFlow for AI solutions.
            </p>
          </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
          <div class="text-center px-xl-2 service-card">
            <div class="icon-circle mb-4 bg-warning-subtle text-warning">
              <span class="fs-1 fw-bold">3</span>
            </div>
            <h5 class="m-2">Cloud Computing</h5>
            <p class="m-0 text-secondary">
              Deploying scalable apps on Google Cloud Platform.
            </p>
          </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
          <div class="text-center px-xl-2 service-card">
            <div class="icon-circle mb-4 bg-success-subtle text-success">
              <span class="fs-1 fw-bold">4</span>
            </div>
            <h5 class="m-2">Team Collaboration</h5>
            <p class="m-0 text-secondary">
              Effective collaborator leveraging diverse team strengths.
            </p>
          </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
          <div class="text-center px-xl-2 service-card">
            <div class="icon-circle mb-4 bg-danger-subtle text-danger">
              <span class="fs-1 fw-bold">5</span>
            </div>
            <h5 class="m-2">Problem Solving</h5>
            <p class="m-0 text-secondary">
              Analytical approach to finding effective solutions.
            </p>
          </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
          <div class="text-center px-xl-2 service-card">
            <div class="icon-circle mb-4 bg-dark-subtle text-dark">
              <span class="fs-1 fw-bold">6</span>
            </div>
            <h5 class="m-2">Adaptability</h5>
            <p class="m-0 text-secondary">
              Flexible and resilient in evolving tech environments.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .icon-circle {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .service-card:hover .icon-circle {
    transform: scale(1.1) rotate(5deg);
  }

  .animate-fade-down {
    animation: fadeDown 0.8s ease-out forwards;
  }
  .animate-fade-up {
    animation: fadeUp 0.8s ease-out forwards;
    opacity: 0;
    animation-delay: 0.2s;
  }

  @keyframes fadeDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
