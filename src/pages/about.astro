---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About Tafif | Backend & Mobile Developer">
  <!-- Hero Section -->
  <section
    class="bsb-hero-1 px-3 bsb-overlay bsb-hover-pull"
    style="background-image: url('/assets/img/hero/hero-home1.jpg');"
  >
    <div class="container">
      <div class="row justify-content-md-center">
        <div
          class="col-12 col-md-11 col-lg-9 col-xl-7 col-xxl-6 text-center text-white"
        >
          <h1 class="display-3 fw-bold mb-3 animate-fade-down">About Me</h1>
          <p class="lead mb-0 animate-fade-up">
            Get to know the person behind the code.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="bg-light py-5 py-md-8 py-xl-10">
    <div class="container overflow-hidden">
      <div
        class="row gy-2 gy-md-0 justify-content-xxl-center align-items-center"
      >
        <div class="col-12 order-md-0 col-md-4 col-xxl-4">
          <div class="text-center text-md-start me-md-3 me-xl-5">
            <img
              class="img-fluid rounded shadow-lg"
              loading="lazy"
              src="/assets/img/about/tafif.jpg"
              alt="Tafif Assiddiqi"
            />
          </div>
        </div>
        <div class="col-12 order-md-1 col-md-8 col-xxl-6">
          <div class="text-center text-md-start">
            <h2 class="display-3 fw-bold lh-1 mb-3">
              Muhammad Tafif Qairawan Assiddiqi
            </h2>
            <span class="badge bg-primary fs-6 mb-3">Backend Developer</span>
            <span class="badge bg-info fs-6 mb-3">Mobile Developer</span>
            <span class="badge bg-warning fs-6 mb-3">Cloud / DevOps</span>

            <p class="lead mt-3 text-secondary">
              Informatics student at Tanjungpura University focused on
              backend, mobile, cloud, and information system development.
            </p>
            <p>
              I have experience building <strong>mobile applications</strong>,
              <strong>REST APIs</strong>, <strong>admin panels</strong>,
              <strong>gamification systems</strong>, and deploying applications
              using <strong>Laravel</strong>, <strong>Flutter</strong>,
              <strong>Firebase</strong>, and <strong>Google Cloud Platform</strong>.
            </p>
            <p>
              I'm interested in developing digital solutions that are not only
              technically sound but also address real user and business needs.
              Actively involved in <strong>Bangkit Academy 2023</strong> and
              <strong>GDSC UNTAN</strong>.
            </p>

            <div class="d-grid gap-2 d-md-block mt-5">
              <a
                href="https://1drv.ms/w/s!Ah--BAT2NLljiokYKFgsKe1gpH0mQA?e=87QROn"
                target="_blank"
                class="btn btn-primary btn-lg px-4 gap-3">Download Resume</a
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Experience Section -->
  <section class="py-5 py-md-8 py-xl-10">
    <div class="container">
      <div class="row justify-content-md-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-7 col-xxl-6">
          <h2 class="mb-4 display-5 text-center">Experience</h2>
          <hr class="w-50 mx-auto mb-5 mb-xl-9 border-dark-subtle" />
        </div>
      </div>
    </div>

    <div class="container overflow-hidden">
      <div class="row gy-5">
        <!-- Experience 1 -->
        <div class="col-12 col-lg-4">
          <div class="text-center px-xl-2 experience-card">
            <div class="icon-circle mb-4 bg-primary-subtle text-primary">
              <span class="fs-1 fw-bold">1</span>
            </div>
            <h5 class="m-2">Mobile Developer Intern</h5>
            <p class="text-primary fst-italic mb-2">Software House / IT Consultant</p>
            <p class="m-0 text-secondary">
              Developed Flutter-based HRIS application. Handled API integration,
              data validation, debugging, and code structure improvements.
              Worked on multi-flavor mobile projects with Firebase integration.
            </p>
          </div>
        </div>

        <!-- Experience 2 -->
        <div class="col-12 col-lg-4">
          <div class="text-center px-xl-2 experience-card">
            <div class="icon-circle mb-4 bg-info-subtle text-info">
              <span class="fs-1 fw-bold">2</span>
            </div>
            <h5 class="m-2">Bangkit Academy 2023</h5>
            <p class="text-info fst-italic mb-2">Cloud Computing — Batch 2</p>
            <p class="m-0 text-secondary">
              Learned cloud computing, backend deployment, Google Cloud Platform,
              and capstone development. Group: CC-51. Built Artventure Indonesia
              as the capstone project.
            </p>
          </div>
        </div>

        <!-- Experience 3 -->
        <div class="col-12 col-lg-4">
          <div class="text-center px-xl-2 experience-card">
            <div class="icon-circle mb-4 bg-success-subtle text-success">
              <span class="fs-1 fw-bold">3</span>
            </div>
            <h5 class="m-2">GDSC UNTAN</h5>
            <p class="text-success fst-italic mb-2">Core Team — Curriculum & Developer</p>
            <p class="m-0 text-secondary">
              Participated in developer community activities. Assisted in
              developing technical materials and events.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Competencies -->
  <section class="py-5 py-md-8 py-xl-10">
    <div class="container">
      <div class="row justify-content-md-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-7 col-xxl-6">
          <h2 class="mb-4 display-5 text-center">Core Competencies</h2>
          <hr class="w-50 mx-auto mb-5 mb-xl-9 border-dark-subtle" />
        </div>
      </div>
    </div>

    <div class="container overflow-hidden">
      <div class="row gy-5">
        <div class="col-12 col-sm-6 col-lg-4">
          <div class="text-center px-xl-2 service-card">
            <div class="icon-circle mb-4 bg-primary-subtle text-primary">
              <span class="fs-1 fw-bold">1</span>
            </div>
            <h5 class="m-2">Backend Engineering</h5>
            <p class="m-0 text-secondary">
              REST APIs, Laravel, Node.js / Express, authentication, and database design.
            </p>
          </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
          <div class="text-center px-xl-2 service-card">
            <div class="icon-circle mb-4 bg-info-subtle text-info">
              <span class="fs-1 fw-bold">2</span>
            </div>
            <h5 class="m-2">Mobile Development</h5>
            <p class="m-0 text-secondary">
              Flutter, Dart, Firebase integration, state management with Riverpod & GetX.
            </p>
          </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
          <div class="text-center px-xl-2 service-card">
            <div class="icon-circle mb-4 bg-warning-subtle text-warning">
              <span class="fs-1 fw-bold">3</span>
            </div>
            <h5 class="m-2">Cloud Deployment</h5>
            <p class="m-0 text-secondary">
              Google Cloud Platform, Cloud Run, Firebase, Cloudflare, and cPanel.
            </p>
          </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
          <div class="text-center px-xl-2 service-card">
            <div class="icon-circle mb-4 bg-success-subtle text-success">
              <span class="fs-1 fw-bold">4</span>
            </div>
            <h5 class="m-2">Full-stack Development</h5>
            <p class="m-0 text-secondary">
              End-to-end application development from database to frontend interfaces.
            </p>
          </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
          <div class="text-center px-xl-2 service-card">
            <div class="icon-circle mb-4 bg-danger-subtle text-danger">
              <span class="fs-1 fw-bold">5</span>
            </div>
            <h5 class="m-2">System Design</h5>
            <p class="m-0 text-secondary">
              Architecting scalable systems for business and SaaS solutions.
            </p>
          </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
          <div class="text-center px-xl-2 service-card">
            <div class="icon-circle mb-4 bg-dark-subtle text-dark">
              <span class="fs-1 fw-bold">6</span>
            </div>
            <h5 class="m-2">Team Collaboration</h5>
            <p class="m-0 text-secondary">
              Effective collaborator leveraging diverse team strengths across projects.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Education Section -->
  <section class="bg-light py-5 py-md-8 py-xl-10">
    <div class="container">
      <div class="row justify-content-md-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-7 col-xxl-6">
          <h2 class="mb-4 display-5 text-center">Education</h2>
          <hr class="w-50 mx-auto mb-5 mb-xl-9 border-dark-subtle" />
        </div>
      </div>

      <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
          <div class="bg-white rounded shadow-sm p-4 p-md-5 text-center">
            <h3 class="fw-bold mb-2">Universitas Tanjungpura</h3>
            <p class="text-primary fst-italic mb-3">
              Program Studi Informatika / Ilmu Komputer
            </p>
            <p class="text-secondary mb-0">
              Senior-year student — focusing on backend, mobile, and cloud-based
              system development.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .icon-circle {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .service-card:hover .icon-circle,
  .experience-card:hover .icon-circle {
    transform: scale(1.1) rotate(5deg);
  }

  .experience-card {
    transition: transform 0.3s ease;
  }
  .experience-card:hover {
    transform: translateY(-5px);
  }

  .animate-fade-down {
    animation: fadeDown 0.8s ease-out forwards;
  }
  .animate-fade-up {
    animation: fadeUp 0.8s ease-out forwards;
    opacity: 0;
    animation-delay: 0.2s;
  }

  @keyframes fadeDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
