---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Tafif Assiddiqi | Web Developer & Machine Learning Enthusiast">
  <!-- Hero Section -->
  <section
    class="bsb-hero-1 px-3 bsb-overlay bsb-hover-pull"
    style="background-image: url('/assets/img/hero/hero-home1.jpg');"
  >
    <div class="container">
      <div class="row justify-content-md-center">
        <div
          class="col-12 col-md-11 col-lg-9 col-xl-7 col-xxl-6 text-center text-white"
        >
          <h1 class="display-3 fw-bold mb-3 animate-fade-down">
            Hi, I'm Tafif.
          </h1>
          <p class="lead mb-5 animate-fade-up" style="animation-delay: 0.2s;">
            I build smart web solutions and artificial intelligence models.
            Explore my work below.
          </p>
          <div
            class="d-grid gap-2 d-sm-flex justify-content-sm-center animate-fade-up"
            style="animation-delay: 0.4s;"
          >
            <button type="button" class="btn bsb-btn-2xl btn-light gap-3">
              <a class="nav-link text-dark" href="/portfolio">View Portfolio</a>
            </button>
            <button type="button" class="btn bsb-btn-2xl btn-outline-light">
              <a
                class="nav-link"
                href="https://1drv.ms/w/s!Ah--BAT2NLljiokYKFgsKe1gpH0mQA?e=87QROn"
                target="_blank">My Resume</a
              >
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Preview Section -->
  <section class="py-5 py-md-8 py-xl-10">
    <div class="container">
      <div class="row justify-content-md-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-7 col-xxl-6">
          <h2 class="mb-4 display-5 text-center">Featured Projects</h2>
          <hr class="w-50 mx-auto mb-5 mb-xl-9 border-dark-subtle" />
        </div>
      </div>
    </div>

    <div class="container overflow-hidden">
      <div class="row gy-3 gy-md-2 bsb-project-1-grid">
        <div class="col-12 col-md-6 col-lg-3 bsb-project-1-item">
          <figure
            class="rounded rounded-4 overflow-hidden bsb-overlay-hover shadow-sm"
          >
            <a
              href="/legacy/projects/dicoding-submission/belajar-dasar-pemrograman-web/index.html"
            >
              <img
                class="img-fluid bsb-scale-up bsb-hover-scale"
                loading="lazy"
                src="/assets/img/project/project-img-10.jpg"
                alt="Web Programming Basics"
              />
            </a>
            <figcaption>
              <h5 class="text-white bsb-hover-fadeInLeft">
                Web Programming Basics
              </h5>
              <div class="text-white bsb-hover-fadeInRight">
                Dicoding Submission
              </div>
            </figcaption>
          </figure>
        </div>

        <div class="col-12 col-md-6 col-lg-3 bsb-project-1-item">
          <figure
            class="rounded rounded-4 overflow-hidden bsb-overlay-hover shadow-sm"
          >
            <a
              href="/legacy/projects/dicoding-submission/belajar-membuat-front-end-web-untuk-pemula/index.html"
            >
              <img
                class="img-fluid bsb-scale-up bsb-hover-scale"
                loading="lazy"
                src="/assets/img/project/project-img-11.jpg"
                alt="Front-End for Beginners"
              />
            </a>
            <figcaption>
              <h5 class="text-white bsb-hover-fadeInLeft">
                Front-End for Beginners
              </h5>
              <div class="text-white bsb-hover-fadeInRight">
                Dicoding Submission
              </div>
            </figcaption>
          </figure>
        </div>

        <div class="col-12 col-md-6 col-lg-3 bsb-project-1-item">
          <figure
            class="rounded rounded-4 overflow-hidden bsb-overlay-hover shadow-sm"
          >
            <a href="https://artventureindonesia.github.io/" target="_blank">
              <img
                class="img-fluid bsb-scale-up bsb-hover-scale"
                loading="lazy"
                src="/assets/img/project/project-img-13.jpg"
                alt="Artventure Indonesia"
              />
            </a>
            <figcaption>
              <h5 class="text-white bsb-hover-fadeInLeft">
                Artventure Indonesia
              </h5>
              <div class="text-white bsb-hover-fadeInRight">
                Bangkit Capstone Project
              </div>
            </figcaption>
          </figure>
        </div>

        <div class="col-12 col-md-6 col-lg-3 bsb-project-1-item">
          <figure
            class="rounded rounded-4 overflow-hidden bsb-overlay-hover shadow-sm"
          >
            <a href="/portfolio">
              <img
                class="img-fluid bsb-scale-up bsb-hover-scale"
                loading="lazy"
                src="/assets/img/project/sample.jpg"
                alt="See More"
              />
            </a>
            <figcaption>
              <h3 class="text-white bsb-hover-fadeInLeft">See more...</h3>
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- Profile Section -->
  <section class="bg-light py-5 py-md-8 py-xl-10">
    <div class="container overflow-hidden">
      <div
        class="row gy-2 gy-md-0 justify-content-xxl-center align-items-center"
      >
        <div class="col-12 order-md-0 col-md-4 col-xxl-4">
          <div class="text-center text-md-start me-md-3 me-xl-5">
            <img
              class="img-fluid rounded shadow-lg tilt-effect"
              loading="lazy"
              src="/assets/img/about/tafif.jpg"
              alt="Tafif Assiddiqi"
            />
          </div>
        </div>
        <div class="col-12 order-md-1 col-md-8 col-xxl-6">
          <div class="text-center text-md-start">
            <h2 class="display-3 fw-bold lh-1 mb-3">Tafif Assiddiqi</h2>
            <p class="text-secondary fs-4 mb-2">
              Web Developer & ML Enthusiast
            </p>
            <hr
              class="w-25 mx-auto ms-md-0 mb-4 text-primary"
              style="opacity: 1; height: 3px;"
            />
            <p class="lead text-muted">
              Motivated Computer Science undergraduate at Tanjungpura
              University. I specialize in building Web Applications and
              exploring Machine Learning models. Actively innovating through
              programs like Bangkit Academy and various tech competitions.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section class="bsb-skill-1 py-5 py-md-8 py-xl-10">
    <div class="container overflow-hidden">
      <div class="row justify-content-xl-center gy-3 gy-sm-4">
        <div class="col-12 col-sm-6 col-xl-5">
          <div class="bg-white rounded shadow-sm p-3 p-md-4 p-xxl-5 skill-card">
            <h3 class="fw-bold mb-2">Javascript</h3>
            <p class="text-secondary fst-italic mb-4">
              Dynamic web content & Backend Services (Express.js, Hapi.js)
            </p>
            <div class="progress" style="height: 10px;">
              <div
                class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                role="progressbar"
                style="width: 75%"
                aria-valuenow="75"
                aria-valuemin="0"
                aria-valuemax="100"
              >
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-5">
          <div class="bg-white rounded shadow-sm p-3 p-md-4 p-xxl-5 skill-card">
            <h3 class="fw-bold mb-2">Python</h3>
            <p class="text-secondary fst-italic mb-4">
              Machine Learning, Data Analysis, & TensorFlow
            </p>
            <div class="progress" style="height: 10px;">
              <div
                class="progress-bar progress-bar-striped progress-bar-animated bg-info"
                role="progressbar"
                style="width: 85%"
                aria-valuenow="85"
                aria-valuemin="0"
                aria-valuemax="100"
              >
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-5">
          <div class="bg-white rounded shadow-sm p-3 p-md-4 p-xxl-5 skill-card">
            <h3 class="fw-bold mb-2">Databases</h3>
            <p class="text-secondary fst-italic mb-4">SQL & NoSQL Management</p>
            <div class="progress" style="height: 10px;">
              <div
                class="progress-bar progress-bar-striped progress-bar-animated bg-success"
                role="progressbar"
                style="width: 75%"
                aria-valuenow="75"
                aria-valuemin="0"
                aria-valuemax="100"
              >
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-5">
          <div class="bg-white rounded shadow-sm p-3 p-md-4 p-xxl-5 skill-card">
            <h3 class="fw-bold mb-2">Cloud Computing</h3>
            <p class="text-secondary fst-italic mb-4">
              Google Cloud Platform & Scalable Solutions
            </p>
            <div class="progress" style="height: 10px;">
              <div
                class="progress-bar progress-bar-striped progress-bar-animated bg-warning"
                role="progressbar"
                style="width: 70%"
                aria-valuenow="70"
                aria-valuemin="0"
                aria-valuemax="100"
              >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Custom Animations */
  @keyframes fadeDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-down {
    animation: fadeDown 0.8s ease-out forwards;
  }
  .animate-fade-up {
    opacity: 0; /* logic handled by animation-fill-mode */
    animation: fadeUp 0.8s ease-out forwards;
  }

  /* Enhancements */
  .skill-card {
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    border: 1px solid rgba(0, 0, 0, 0.05);
  }
  .skill-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1) !important;
  }

  .tilt-effect {
    transition: transform 0.5s ease;
  }
  .tilt-effect:hover {
    transform: perspective(1000px) rotateY(10deg) rotateX(5deg);
  }
</style>
