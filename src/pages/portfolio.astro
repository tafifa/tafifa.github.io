---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Portfolio | Tafif Assiddiqi">
  <!-- Hero Section -->
  <section
    class="bsb-hero-1 px-3 bsb-overlay bsb-hover-pull"
    style="background-image: url('/assets/img/hero/hero-home1.jpg');"
  >
    <div class="container">
      <div class="row justify-content-md-center">
        <div
          class="col-12 col-md-11 col-lg-9 col-xl-7 col-xxl-6 text-center text-white"
        >
          <h1 class="display-3 fw-bold mb-3 animate-fade-down">My Portfolio</h1>
          <p class="lead mb-0 animate-fade-up">
            A collection of my projects, experiments, and collaborative works.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Portfolio Grid -->
  <section class="py-5 py-md-8 py-xl-10">
    <div class="container">
      <div class="row justify-content-md-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-7 col-xxl-6">
          <p class="text-secondary mb-5 text-center lead fs-4">
            Showcasing projects spanning mobile development, backend engineering,
            cloud deployment, and machine learning.
          </p>
          <hr class="w-50 mx-auto mb-5 mb-xl-9 border-dark-subtle" />
        </div>
      </div>
    </div>

    <div class="container overflow-hidden">
      <div class="row gy-3 gy-md-2 bsb-project-1-grid">
        <!-- Project 1: Snappie -->
        <div class="col-12 col-md-6 col-lg-3 bsb-project-1-item">
          <figure
            class="rounded rounded-4 overflow-hidden bsb-overlay-hover shadow-sm"
          >
            <a href="https://snappie-team.github.io/" target="_blank">
              <img
                class="img-fluid bsb-scale-up bsb-hover-scale"
                loading="lazy"
                src="/assets/img/project/project-img-1.jpg"
                alt="Snappie"
              />
            </a>
            <figcaption>
              <h5 class="text-white bsb-hover-fadeInLeft">Snappie</h5>
              <div class="text-white bsb-hover-fadeInRight">
                Flutter + Laravel + Firebase
              </div>
            </figcaption>
          </figure>
        </div>

        <!-- Project 2: Artventure Indonesia -->
        <div class="col-12 col-md-6 col-lg-3 bsb-project-1-item">
          <figure
            class="rounded rounded-4 overflow-hidden bsb-overlay-hover shadow-sm"
          >
            <a href="https://artventureindonesia.github.io/" target="_blank">
              <img
                class="img-fluid bsb-scale-up bsb-hover-scale"
                loading="lazy"
                src="/assets/img/project/project-img-13.jpg"
                alt="Artventure Indonesia"
              />
            </a>
            <figcaption>
              <h5 class="text-white bsb-hover-fadeInLeft">
                Artventure Indonesia
              </h5>
              <div class="text-white bsb-hover-fadeInRight">
                Node.js + Google Cloud Run
              </div>
            </figcaption>
          </figure>
        </div>

        <!-- Project 3: UrangTuo -->
        <div class="col-12 col-md-6 col-lg-3 bsb-project-1-item">
          <figure
            class="rounded rounded-4 overflow-hidden bsb-overlay-hover shadow-sm"
          >
            <a href="/portfolio">
              <img
                class="img-fluid bsb-scale-up bsb-hover-scale"
                loading="lazy"
                src="/assets/img/project/project-img-2.jpg"
                alt="UrangTuo"
              />
            </a>
            <figcaption>
              <h5 class="text-white bsb-hover-fadeInLeft">UrangTuo</h5>
              <div class="text-white bsb-hover-fadeInRight">
                Full-stack Web Platform
              </div>
            </figcaption>
          </figure>
        </div>

        <!-- Project 4: UrinAI -->
        <div class="col-12 col-md-6 col-lg-3 bsb-project-1-item">
          <figure
            class="rounded rounded-4 overflow-hidden bsb-overlay-hover shadow-sm"
          >
            <a href="/portfolio">
              <img
                class="img-fluid bsb-scale-up bsb-hover-scale"
                loading="lazy"
                src="/assets/img/project/project-img-3.jpg"
                alt="UrinAI"
              />
            </a>
            <figcaption>
              <h5 class="text-white bsb-hover-fadeInLeft">UrinAI</h5>
              <div class="text-white bsb-hover-fadeInRight">
                ML / Data Engineering
              </div>
            </figcaption>
          </figure>
        </div>

        <!-- Project 5: Fire Detection CCTV -->
        <div class="col-12 col-md-6 col-lg-3 bsb-project-1-item">
          <figure
            class="rounded rounded-4 overflow-hidden bsb-overlay-hover shadow-sm"
          >
            <a href="/portfolio">
              <img
                class="img-fluid bsb-scale-up bsb-hover-scale"
                loading="lazy"
                src="/assets/img/project/project-img-4.jpg"
                alt="Fire Detection CCTV"
              />
            </a>
            <figcaption>
              <h5 class="text-white bsb-hover-fadeInLeft">
                Fire Detection CCTV
              </h5>
              <div class="text-white bsb-hover-fadeInRight">
                VGG-16 + MobileNetV2
              </div>
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .animate-fade-down {
    animation: fadeDown 0.8s ease-out forwards;
  }
  .animate-fade-up {
    animation: fadeUp 0.8s ease-out forwards;
    opacity: 0;
    animation-delay: 0.2s;
  }

  @keyframes fadeDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
