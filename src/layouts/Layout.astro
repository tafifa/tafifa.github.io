---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Tafif Assiddiqi - Web Developer and Machine Learning Enthusiast based in Indonesia.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="icon"
      type="image/png"
      sizes="512x512"
      href="/assets/favicon/logo.png"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Tafif Assiddiqi" />
    <title>{title}</title>

    <!-- Google Fonts: Outfit (Modern, Geometric) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Bootstrap CSS (Legacy Support) -->
    <link rel="stylesheet" href="/assets/css/concept-bsb.css" />
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Scripts -->
    <script src="https://unpkg.com/jquery@3.6.1/dist/jquery.min.js"></script>
    <script
      src="https://unpkg.com/isotope-layout@3.0.6/dist/isotope.pkgd.min.js"
    ></script>
    <script src="https://unpkg.com/imagesloaded@5.0.0/imagesloaded.pkgd.min.js"
    ></script>
    <script
      src="https://unpkg.com/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
    ></script>
    <script src="/assets/controller/project-1.js" is:inline></script>
  </body>
</html>

<style is:global>
  :root {
    --font-family-base: "Outfit", sans-serif;
    --bs-body-font-family: "Outfit", sans-serif;
    --accent-color: #0d6efd;
    --accent-gradient: linear-gradient(45deg, #0d6efd, #0dcaf0);
  }

  body {
    font-family: var(--font-family-base);
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  /* Premium Button Styles */
  .btn-primary {
    background: var(--accent-color);
    border: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
  }
</style>
